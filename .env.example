# =====================================================================
#  heart 环境变量模板
#  用法：cp .env.example .env  →  填入真实值（.env 已被 .gitignore 忽略，不会提交）
#  代码里 os.environ 优先于 config.yaml，所以密钥请只放这里，别写进 config.yaml
# =====================================================================

# ---- 「想」侧 LLM（潜意识冒想法 + 判别层）----
# 任意 OpenAI 兼容接口即可：OpenAI / DeepSeek / 本地 vLLM / Ollama / 中转网关 …
HEART_BASE_URL="https://api.openai.com/v1"
HEART_API_KEY="sk-xxxxxxxx"

# ---- 「做」侧执行层（可插拔「身体」）----
# 默认 executor=hermes，走 Hermes API Server（OpenAI 协议，能触发带工具的完整 agent 执行）
# 需要一个运行中的 Hermes agent，并启用它的 api_server（OpenAI 兼容接口）
HERMES_BASE_URL="http://127.0.0.1:8642"
HERMES_API_KEY="your-hermes-api-server-key"

# 若没有 Hermes，想用 opencode 作为执行层：
#   1) 安装 opencode CLI；2) 在 config.yaml 里把 executor 改成 opencode
#   无需设置 HERMES_* 这两个变量
